{
  "name": "@my-bookmark/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "go run ./cmd/server",
    "seed:bookmarks": "tsx scripts/seed-bookmarks.ts",
    "backfill:embeddings": "tsx scripts/backfill-embeddings.ts",
    "backfill:places": "tsx scripts/backfill-places.ts",
    "typecheck": "go vet ./... && tsc --noEmit",
    "lint": "go vet ./... && biome check scripts",
    "test": "go test ./... && vitest run scripts",
    "build": "go build -o dist/api ./cmd/server"
  },
  "dependencies": {
    "@my-bookmark/ai": "workspace:*",
    "@my-bookmark/shared": "workspace:*",
    "@supabase/supabase-js": "^2.110.0",
    "cheerio": "^1.2.0",
    "dotenv": "latest",
    "heic-decode": "^2.1.0",
    "sharp": "^0.35.3",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/heic-decode": "^2.0.0",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "7.0.2",
    "vitest": "latest"
  }
}
